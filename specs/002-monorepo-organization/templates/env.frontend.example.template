# Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# API Configuration
# =============================================================================

# Backend API base URL
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# API timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=30000

# =============================================================================
# Authentication
# =============================================================================

# JWT token key for localStorage (optional)
NEXT_PUBLIC_AUTH_TOKEN_KEY=auth_token

# Session timeout in minutes
NEXT_PUBLIC_SESSION_TIMEOUT=60

# =============================================================================
# Feature Flags
# =============================================================================

# Enable debug mode (shows additional logs in console)
NEXT_PUBLIC_DEBUG_MODE=false

# Enable experimental features
NEXT_PUBLIC_EXPERIMENTAL_FEATURES=false

# =============================================================================
# Analytics and Monitoring (optional)
# =============================================================================

# Google Analytics tracking ID
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================================
# Build Configuration
# =============================================================================

# Application environment
NEXT_PUBLIC_APP_ENV=development

# Application version
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# Notes
# =============================================================================

# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Server-side only variables should NOT use NEXT_PUBLIC_ prefix
# For production, use environment-specific .env files:
#   - .env.local (local development, gitignored)
#   - .env.production (production values, gitignored)
#   - .env.example (template, committed to git)
