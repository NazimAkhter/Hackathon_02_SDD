# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Application Configuration
# =============================================================================

# Application environment (development, staging, production)
APP_ENV=development

# Application name
APP_NAME=backend-api

# Application version
APP_VERSION=1.0.0

# Debug mode (enable detailed logging)
DEBUG=true

# =============================================================================
# Server Configuration
# =============================================================================

# Server host (use 0.0.0.0 to allow external connections)
HOST=0.0.0.0

# Server port
PORT=8000

# Allowed CORS origins (comma-separated)
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Database Configuration
# =============================================================================

# Database URL format: postgresql://user:password@host:port/database
# Development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapp_dev

# Database pool size (connections)
DB_POOL_SIZE=10

# Database connection timeout (seconds)
DB_POOL_TIMEOUT=30

# Enable SQL query logging
DB_ECHO=false

# =============================================================================
# Authentication & Security
# =============================================================================

# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# JWT token expiration time (minutes)
JWT_EXPIRATION_MINUTES=60

# Password hashing algorithm (bcrypt)
PASSWORD_HASH_ALGORITHM=bcrypt

# Bcrypt rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# Redis Configuration (optional, for caching/sessions)
# =============================================================================

# Redis URL format: redis://host:port/db
# REDIS_URL=redis://localhost:6379/0

# Redis cache TTL (seconds)
# REDIS_CACHE_TTL=300

# =============================================================================
# Email Configuration (optional)
# =============================================================================

# SMTP server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# File Storage (optional)
# =============================================================================

# Upload directory
# UPLOAD_DIR=./uploads

# Max upload size in MB
# MAX_UPLOAD_SIZE_MB=10

# Allowed file extensions (comma-separated)
# ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# =============================================================================
# External Services (optional)
# =============================================================================

# AWS Configuration
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# =============================================================================
# Monitoring and Logging
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional, logs to console if not set)
# LOG_FILE=./logs/app.log

# Enable request logging
LOG_REQUESTS=true

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================================
# Rate Limiting (optional)
# =============================================================================

# Enable rate limiting
# RATE_LIMIT_ENABLED=true

# Rate limit per minute
# RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Background Tasks (optional, Celery)
# =============================================================================

# Celery broker URL (Redis or RabbitMQ)
# CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Testing Configuration
# =============================================================================

# Test database URL (separate from development database)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapp_test

# =============================================================================
# Notes
# =============================================================================

# All variables in this file are server-side only
# They are NOT exposed to the frontend
# For production, use environment-specific .env files:
#   - .env (local development, gitignored)
#   - .env.production (production values, gitignored)
#   - .env.example (template, committed to git)

# Generate secure random keys:
#   openssl rand -hex 32

# Database URL examples:
#   PostgreSQL: postgresql://user:password@localhost:5432/dbname
#   MySQL: mysql://user:password@localhost:3306/dbname
#   SQLite: sqlite:///./app.db
